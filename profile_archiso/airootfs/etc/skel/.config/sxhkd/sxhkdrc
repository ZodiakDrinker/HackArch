#
# WM Independent Hotkeys
#

# Terminal Emulator
super + Return
	kitty

# Program Launcher (Rofi)
super + space
	rofi -no-config -no-lazy-grab -show drun -modi drun -theme ~/.config/polybar/hack/scripts/rofi/launcher.rasi

# Make sxhkd reload its configuration files
super + shift + Escape
	pkill -USR1 -x sxhkd

# Application Shortcuts
super + shift + f
	firefox

super + shift + s
	flameshot gui

super + Escape
	sh ~/.config/polybar/hack/scripts/powermenu.sh

#
# BSPWM Hotkeys
#

# Quit / Restart BSPWM
super + shift + {q,r}
	bspc {quit,wm -r}

# Close / Kill Node
super + {_,shift + }w
	bspc node -{c,k}

# Alternate between tiled and monocle layout
super + m
	bspc desktop -l next

# Send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# Swap current node and biggest window
super + g
	bspc node -s biggest.window

#
# State / Flags
#

# Set window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# Set node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

#
# Focus / Swap
#

# Focus / Swap node in direction
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# Focus path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# Focus next/previous window in current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# Focus next/previous desktop
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# Focus last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# Focus older/newer node in history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# Focus or send to desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# Preselect
#

# Preselect direction
super + ctrl + {Left,Down,Up,Right}
	bspc node -p {west,south,north,east}

# Preselect ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# Cancel preselection for focused node
super + ctrl + space
	bspc node -p cancel

# Cancel preselection for focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# Move / Resize
#

# Expand window outwards
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Contract window inwards
super + alt + shift + {Left,Down,Up,Right}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Move floating window
super + ctrl + alt + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

#
# Media Keys (Pipewire / Pulseaudio)
#

# Raise Volume (Limit 100%)
XF86AudioRaiseVolume
	VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '\d+(?=%)' | head -n 1); \
	[ "$VOL" -lt 100 ] && pactl set-sink-volume @DEFAULT_SINK@ +5%

# Lower Volume
XF86AudioLowerVolume
	pactl set-sink-volume @DEFAULT_SINK@ -5%

# Mute / Unmute
XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle
