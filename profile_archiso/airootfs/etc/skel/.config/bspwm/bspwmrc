#!/bin/sh

# Iniciar gestor de atajos de teclado
pgrep -x sxhkd > /dev/null || sxhkd &

# Definición de espacios de trabajo
bspc monitor -d I II III IV V VI VII VIII IX X

# Configuración visual de ventanas
bspc config border_width         2
bspc config window_gap          12
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Compatibilidad con herramientas Java (Burp Suite, etc.)
wmname LG3D &

# Integración con VMware (si se detecta el binario)
if command -v vmware-user-suid-wrapper >/dev/null 2>&1; then
    vmware-user-suid-wrapper &
fi

# Compositor de efectos visuales
if command -v picom >/dev/null 2>&1; then
    picom --config "~/.config/picom/picom.conf" -b
fi

# Fondo de pantalla (con fallback si no existe la imagen)
WALLPAPER="~/.config/Wallpapers/wall.png"
if [ -f "$WALLPAPER" ]; then
    feh --bg-fill "$WALLPAPER" &
else
    xsetroot -solid "#1e1e2e" &
fi

# Iniciar Polybar
if [ -x "$HOME/.config/polybar/launch.sh" ]; then
    "$HOME/.config/polybar/launch.sh" --hack &
fi
